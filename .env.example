# ==========================================
# Spotify Developer Credentials
# Get these from: https://developer.spotify.com/dashboard
# ==========================================
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ==========================================
# Setlist.fm API Key
# Get this from: https://www.setlist.fm/settings/api
# ==========================================
SETLIST_FM_API_KEY=your_setlist_fm_api_key_here

# ==========================================
# Stateless Session Secret
# 32+ character secret key for encrypted JWT (jose) session handling
# Can be generated using: openssl rand -base64 32
# ==========================================
SESSION_SECRET=stagepass_super_secret_session_key_32bytes_min_len

# ==========================================
# App Base URL
# Default local development URL (strictly 127.0.0.1 for Spotify loopback security)
# ==========================================
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3000
